          "name": "Get rendered SEO head metadata for a URL",
          "request": {
            "name": "Get rendered SEO head metadata for a URL",
            "description": {
              "content": "Returns the rendered Yoast SEO head markup for the given site URL, along with the parsed metadata and its schema.org JSON-LD graph.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "yoast",
                "v1",
                "get_head"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) Absolute URL on burgersinghonline.com to render SEO head metadata for."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
